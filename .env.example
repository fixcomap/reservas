# Variables de la API. En local se leen de este archivo copiado a .env (raíz del repo).
# En producción (Cloud Run) se cargan como variables del servicio; ver DEPLOY.md.

# Vacío (o development) en tu PC; production en Cloud Run.
# En production no hay valores por defecto: si falta una obligatoria, la API no arranca,
# y la cookie de sesión exige HTTPS.
NODE_ENV=

# --- Base de datos ---
# Local: contraseña del Postgres del docker-compose (se usa si DATABASE_URL está vacía)
POSTGRES_PASSWORD=
# Producción (obligatoria): connection string de Neon. Siempre se conecta con SSL verificado.
# Ej: postgresql://usuario:clave@host.neon.tech/base?sslmode=require
DATABASE_URL=

# --- URLs ---
# Puerto: Cloud Run lo define solo. En local, por defecto 3000.
PORT=
# Front (obligatoria en producción): adonde vuelve el jugador después de pagar
# y único origen aceptado por CORS. Local: por defecto http://localhost:5173
FRONT_URL=
# URL pública de la API (obligatoria en producción). Con ella se arma la URL del
# webhook de Mercado Pago (<API_URL>/webhooks/mercadopago). Local: http://localhost:3000
API_URL=

# --- Mercado Pago (obligatorias en producción) ---
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Hoy no se usa en el código (Checkout Pro redirige a la página de Mercado Pago)
MP_PUBLIC_KEY=

# --- Opcionales ---
# Club que muestra la app (por defecto 1)
CLUB_ID=
# IPs o rangos extra de proxies delante de la API, separados por coma
# (solo si se agrega un balanceador externo de Google; ver DEPLOY.md)
PROXIES_CONFIABLES=

# SMTP (vacío = no se mandan mails). Mailpit: SMTP_HOST=localhost, SMTP_PORT=1025
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
