# Variables del front (Vite). En local no hace falta ninguna: se usa el proxy /api.
# En Cloudflare Pages se cargan como variables de entorno del build.

# URL pública de la API, sin barra final. Obligatoria en el build de producción.
VITE_API_URL=

# true = muestra el cartel "Versión de demostración" arriba de todo
VITE_DEMO=
